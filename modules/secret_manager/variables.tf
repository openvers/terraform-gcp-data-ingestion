## ---------------------------------------------------------------------------------------------------------------------
## MODULE PARAMETERS
## These variables are expected to be passed in by the operator
## ---------------------------------------------------------------------------------------------------------------------

variable "secret_id" {
    type        = string
    description = "Google Secret Manager Secret ID"
}

## ---------------------------------------------------------------------------------------------------------------------
## OPTIONAL PARAMETERS
## These variables have defaults and may be overridden
## ---------------------------------------------------------------------------------------------------------------------

variable "secret_value" {
    type        = string
    description = "Google Secret Manager Secret value. If left blank, then autogenerated secret value.
    default     = null
    sensitive   = true
}

variable "secret_members" {
    type        = list(string)
    description = "List of user/service account emails"
    default     = []
}