export GOOGLE_PROJECT="$(gcloud config get-value project 2>/dev/null)"
export GOOGLE_CLOUD_PROJECT="$GOOGLE_PROJECT"
export GOOGLE_REGION="${GOOGLE_REGION:-us-central1}"

source_env_if_exists ~/creds/gcp.secrets.envrc

export TF_VAR_IMPERSONATE_SERVICE_ACCOUNT_EMAIL=$GOOGLE_IMPERSONATE_SERVICE_ACCOUNT_EMAIL
export TF_VAR_WORKLOAD_IDENTITY_POOL_ID=$GOOGLE_WORKLOAD_IDENTITY_POOL_ID